# Copy outside the repository to /etc/mrst/api.env and set mode 0600.
APP_NAME=Morashiter
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.morashiter.com
APP_KEY=
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=db-host.internal
DB_PORT=6432
DB_DATABASE=mrst
DB_USERNAME=mrst_app
DB_PASSWORD=
DB_EMULATE_PREPARES=true
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=198.51.100.0/27
ADMIN_ALLOWED_IPS=
MSNC_FETCH_ENABLED=false
MSNC_ALLOWED_SCHEMES=https
MSNC_TRUSTED_PRIVATE_HOSTS=
# AI analysis of official announcements. mock never calls out; set sakura only with the 1Password key.
AI_PROVIDER=mock
AI_MAX_RETRIES=1
SAKURA_AI_BASE_URL=https://api.ai.sakura.ad.jp/v1
SAKURA_AI_MODEL=llm-jp-3.1-8x13b-instruct4
SAKURA_AI_API_KEY=
# msic: fetch companies' own announcements from admin-registered official domains
MSIC_FETCH_ENABLED=false
MSIC_BATCH_SIZE=20
# Cost guard for real AI providers (mock is not counted)
AI_MAX_ANALYSES_PER_DAY=20
# Official-domain research for link candidates (admin confirms before registering).
# Calls Sakura only when AI_PROVIDER=sakura; DAILY_LIMIT is its own cap, separate from AI_MAX_ANALYSES_PER_DAY.
DOMAIN_RESEARCH_ENABLED=false
DOMAIN_RESEARCH_DAILY_LIMIT=10
DOMAIN_RESEARCH_MAX_ATTEMPTS=2
DOMAIN_RESEARCH_MAX_PAGES=3
# Official announcement search (rules + AI). false hides the buttons and stops the scheduler.
ANNOUNCEMENT_SEARCH_ENABLED=false
ANNOUNCEMENT_SEARCH_AI=true
ANNOUNCEMENT_SEARCH_AUTO=true
ANNOUNCEMENT_SEARCH_DAILY_LIMIT=20
ANNOUNCEMENT_SEARCH_MAX_PAGES=10
# msgn: publish approved incidents to www.morashiter.com (admin "公開" page or `php artisan msgn:publish`).
# Keep false until the S3 and CDN keys below are filled in by hand (root, 0600). Never paste the values elsewhere.
MSGN_ENABLED=false
# Daily 03:30 Asia/Tokyo publication by the scheduler; enable after initial verification.
MSGN_AUTO_PUBLISH=false
MSGN_INDEXABLE=false
MSGN_PUBLIC_URL=https://www.morashiter.com
MSGN_S3_ENDPOINT=https://s3.isk01.sakurastorage.jp
MSGN_S3_REGION=jp-north-1
MSGN_S3_BUCKET=
MSGN_S3_KEY=
MSGN_S3_SECRET=
MSGN_CDN_DOMAIN=www.morashiter.com
MSGN_CDN_API_TOKEN=
MSGN_CDN_API_SECRET=
