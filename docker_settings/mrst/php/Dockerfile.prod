FROM dunglas/frankenphp:1.12.7-php8.5-bookworm@sha256:d502c4823f75f7738b463919ae993a6a4c7ccccab034e3e3020d3b9d042ec83e AS php-runtime

RUN install-php-extensions bcmath intl mbstring opcache pcntl pdo_pgsql pgsql zip
COPY docker_settings/mrst/php/prod.ini /usr/local/etc/php/conf.d/99-mrst-prod.ini
WORKDIR /app

FROM php-runtime AS vendor
COPY --from=composer:2@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac /usr/bin/composer /usr/local/bin/composer
COPY services/mrst/composer.json services/mrst/composer.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --no-progress
COPY services/mrst/ ./
RUN php artisan package:discover --ansi --no-interaction

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS assets
WORKDIR /app
COPY services/mrst/package.json services/mrst/package-lock.json ./
RUN npm ci --ignore-scripts
COPY services/mrst/resources ./resources
COPY services/mrst/vite.config.js ./vite.config.js
RUN npm run build

FROM php-runtime AS web-prod
COPY --from=vendor --chown=10001:10001 /app /app
COPY --from=assets --chown=10001:10001 /app/public/build /app/public/build
COPY docker_settings/mrst/frankenphp/Caddyfile.prod /etc/frankenphp/Caddyfile
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R 10001:10001 storage bootstrap/cache \
    && setcap -r /usr/local/bin/frankenphp
ENV XDG_CONFIG_HOME=/tmp/mrst-caddy-config \
    XDG_DATA_HOME=/tmp/mrst-caddy-data
USER 10001:10001
EXPOSE 8080

FROM web-prod AS worker-prod
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY workers/msnc-python/requirements.txt /tmp/msnc-requirements.txt
RUN python3 -m venv /opt/msnc-venv \
    && /opt/msnc-venv/bin/pip install --no-cache-dir -r /tmp/msnc-requirements.txt
COPY workers/msnc-python/ /opt/msnc/
ENV PATH=/opt/msnc-venv/bin:${PATH}
USER 10001:10001
ENTRYPOINT []
HEALTHCHECK NONE
