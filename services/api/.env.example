APP_NAME=RightsRelay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:6546
FRONTEND_URL=http://localhost:6544
CORS_ALLOWED_ORIGINS=http://localhost:6544

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rightsrelay
DB_USERNAME=rightsrelay
DB_PASSWORD=rightsrelay_local_dev
PGCONNECT_TIMEOUT=5

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Incident collection. Keep AI off in local development unless explicitly
# testing a real, billed Sakura AI Engine request.
CRAWL_CONNECT_TIMEOUT_SECONDS=5
CRAWL_TIMEOUT_SECONDS=30
CRAWL_MAX_BYTES=2097152
CRAWL_ALLOWED_PORTS=80,443
CRAWL_JOB_TIMEOUT=120
DB_QUEUE_RETRY_AFTER=180

AI_PROVIDER=mock
SAKURA_AI_BASE_URL=
SAKURA_AI_API_KEY=
SAKURA_AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
